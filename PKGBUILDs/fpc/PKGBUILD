# Maintainer: BlackIkeEagle <ike DOT devolder AT gmail DOT com>
# Contributor: Valeriy Lyasotskiy <onestep@ukr.net>
# Contributor: Jan Willemson <janwil@hot.ee>
# Contributor: Hugo Ideler <hugoideler@dse.nl>
# Original PKGBUILD: Andre Naumann <anaumann@SPARCed.org>
# See http://bbs.archlinux.org/viewtopic.php?t=9318&highlight=fpc

pkgname=fpc
pkgver=3.2.3
pkgrel=1
pkgdesc="Free Pascal Compiler, Turbo Pascal 7.0 and Delphi compatible."
arch=('powerpc' 'powerpc64' 'powerpc64le' 'espresso')
url="http://www.freepascal.org/"
license=('GPL' 'LGPL' 'custom')
backup=("etc/fpc.cfg")
depends=('ncurses' 'zlib' 'expat' 'binutils' 'make')
options=('zipman' 'libtool' 'staticlibs' '!debug' 'strip')
source=("git+https://gitlab.com/freepascal.org/fpc/source.git#branch=fixes_3_2")
sha512sums=('SKIP')

build() {
  cd "${srcdir}"/source
  pushd compiler
  fpcmake -Tall
  popd

  # For PPC64BE ELFv2
  if [[ "$CARCH" == "powerpc64" ]]; then
      make build OPT="-Cb -Caelfv2"
  fi

  # For PPC64LE
  if [[ "$CARCH" == "powerpc64le" ]]; then
      make build OPT="-Caelfv2"
  fi

  # For PPC32
  if [[ "$CARCH" == "powerpc" || "$CARCH" == "espresso" ]]; then
      make build
  fi
}

package() {
  cd "${srcdir}"/source

  export HOME="${srcdir}"

  make -j1 PREFIX="${pkgdir}"/usr NO_MAN_COMPRESS=1 install

  export PATH="${pkgdir}"/usr/bin:$PATH

  install -Dm0644 rtl/COPYING.FPC "${pkgdir}"/usr/share/licenses/${pkgname}/COPYING.FPC

  if [[ "$CARCH" == "powerpc64" || "$CARCH" == "powerpc64le" ]]; then
      ln -s /usr/lib/fpc/${pkgver}/ppcppc64 "${pkgdir}"/usr/bin/
  fi

  if [[ "$CARCH" == "powerpc" || "$CARCH" == "espresso" ]]; then
      ln -s /usr/lib/fpc/${pkgver}/ppcppc "${pkgdir}"/usr/bin/
  fi

  mkdir -p "${pkgdir}"/etc
  "${pkgdir}"/usr/lib/fpc/${pkgver}/samplecfg "${pkgdir}/usr/lib/fpc/${pkgver}" "${pkgdir}"/etc
  "${pkgdir}"/usr/lib/fpc/${pkgver}/samplecfg "/usr/lib/fpc/${pkgver}" "${pkgdir}"/etc
  mkdir -p "${pkgdir}/usr/lib/fpc/${pkgver}/ide/text/"
  cp "${srcdir}/.fp/fp."{cfg,ini} "${pkgdir}/usr/lib/fpc/${pkgver}/ide/text/"

  # For PPC64BE ELFv2
  if [[ "$CARCH" == "powerpc64" ]]; then
  sed -i '242a\
-Cb\
-Caelfv2' "${pkgdir}"/etc/fpc.cfg

  # use -fPIC by default
  echo -e "#ifdef cpuppc64\n# for ppc64 use -fPIC by default\n-Cg\n#endif" >> "${pkgdir}/etc/fpc.cfg"
  fi

  # For PPC64LE
  if [[ "$CARCH" == "powerpc64le" ]]; then
  sed -i '242a\
-Caelfv2' "${pkgdir}"/etc/fpc.cfg

  # use -fPIC by default
  echo -e "#ifdef cpuppc64\n# for ppc64 use -fPIC by default\n-Cg\n#endif" >> "${pkgdir}/etc/fpc.cfg"
  fi

  if [[ "$CARCH" == "powerpc" || "$CARCH" == "espresso" ]]; then

  # use -fPIC by default
  echo -e "#ifdef cpuppc\n# for ppc use -fPIC by default\n-Cg\n#endif" >> "${pkgdir}/etc/fpc.cfg"
  fi

  find "${pkgdir}"/etc/ -type f -exec sed -i "s|"${pkgdir}"||g" {} \;
}
