# Maintainer: aquova <austinbricker at protonmail dot com>

pkgname=perfect_dark-git
_pkgname=perfect_dark
pkgver=r7572.67675d898
pkgrel=1
pkgdesc='PC port of Perfect Dark'
url='https://github.com/Link4Electronics/perfect_dark'
arch=('powerpc' 'powerpc64' 'powerpc64le' 'espresso')
license=("MIT")
depends=('glu' 'sdl2' 'zlib')
makedepends=('cmake' 'gcc' 'git' 'python')
options=('!debug' 'strip')
source=("git+https://github.com/Link4Electronics/perfect_dark.git"
        "io.github.fgsfdsfgs.perfect_dark.png::https://raw.githubusercontent.com/Link4Electronics/perfect_dark/port/dist/linux/io.github.perfect_dark_pc_port.perfect_dark.png")
md5sums=('SKIP' 'SKIP')

pkgver() {
    cd $srcdir/$_pkgname
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd $srcdir/$_pkgname
    sed -i 's/add_compile_options(-Og)/add_compile_options(-O2)/' CMakeLists.txt
    cmake -B build -S .
    cmake --build build
}

package() {
    cd $srcdir/$_pkgname

    local pd_bin
    pd_bin=$(find build -maxdepth 1 -name 'pd.*' -type f 2>/dev/null | head -1)

    install -Dm755 "$pd_bin" "$pkgdir/usr/bin/perfect-dark"

    install -Dm644 "$srcdir/io.github.fgsfdsfgs.perfect_dark.png" \
      "$pkgdir/usr/share/pixmaps/io.github.fgsfdsfgs.perfect_dark.png"

    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/io.github.fgsfdsfgs.perfect_dark.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Perfect Dark
Comment=PC port of Perfect Dark
Icon=io.github.fgsfdsfgs.perfect_dark
Exec=pd
Terminal=false
StartupWMClass=pd
Categories=Game;Action;
EOF

    cat > "$pkgdir/usr/bin/pd" << 'SCRIPT'
#!/usr/bin/env bash
DATADIR="${XDG_DATA_HOME:-$HOME/.local/share}/perfectdark"
mkdir -p "$DATADIR/data"
exec perfect-dark --basedir="$DATADIR/data" "$@"
SCRIPT
    chmod +x "$pkgdir/usr/bin/pd"
}
